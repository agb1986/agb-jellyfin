# Copy to .env for local development. .env and .env.local are gitignored.
#
# These values are inlined into the JavaScript bundle at build time by
# react-native-dotenv, which means they end up as plain strings inside the
# .vpkg. A .vpkg is an archive that gets sideloaded onto every device, so
# anything here is readable by anyone holding one.
#
# Therefore: URLs and other non-secrets only. Never put a Jellyfin API key,
# password, or access token here. Tokens are obtained at runtime via Quick
# Connect and stored per-device.

# Base URL of the Jellyfin server, no trailing slash, e.g. http://192.168.1.10:8096
# Development convenience only: it pre-fills the server address so a dev build
# can reach a server before the setup screen exists. The value a user enters at
# runtime takes precedence.
JELLYFIN_SERVER_URL=
